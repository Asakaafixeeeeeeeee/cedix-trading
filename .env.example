# Database (embedded PostgreSQL in dev — point to managed Postgres in production)
DATABASE_URL="postgresql://postgres@localhost:5433/postgres"

# Auth — use a long random secret in production
JWT_SECRET="change-me"

# Payteller payment gateway
# Leave blank to run in SANDBOX mode (built-in simulated checkout).
# Fill all three to switch to LIVE mode.
PAYTELLER_MODE="sandbox"
PAYTELLER_BASE_URL=""
PAYTELLER_API_KEY=""
PAYTELLER_MERCHANT_ID=""
